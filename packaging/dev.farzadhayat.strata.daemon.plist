<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.farzadhayat.strata.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Strata.app/Contents/MacOS/Strata</string>
		<string>--daemon</string>
		<string>--user</string>
		<string>__USER__</string>
		<string>--config</string>
		<string>__CONFIG__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>StandardOutPath</key>
	<string>/var/log/strata/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/strata/daemon.log</string>
</dict>
</plist>
